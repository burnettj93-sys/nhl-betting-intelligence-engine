<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhlengine.database-backup</string>

    <!-- P0.8 (2026-09-24 hardening block): timestamped, rotated
         backups (via sqlite3's online backup API, safe against a
         concurrently-writing process) of the real, accumulating,
         non-reproducible databases -- nhl.db, prospective_observations.db,
         paper_bankroll.db, auth_store.db. Runs after the morning
         sync/settlement/post-mortem sequence (07:00/07:15/07:30) so the
         day's freshly-committed real data is included. See
         docs/BACKUP_AND_RESTORE.md. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>-m</string>
        <string>operational.backup_databases</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/database_backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/database_backup.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
