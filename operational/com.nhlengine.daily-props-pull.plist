<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhlengine.daily-props-pull</string>

    <!-- Once-daily, budget-gated sweep of the SECONDARY-priority markets
         (points/assists/goals, Part 10) across every known event, soonest
         puck-drop first. Primary priority (SOG/Saves) is instead handled
         by the two more frequent, puck-drop-relative sweep jobs below. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>-m</string>
        <string>operational.live_odds_daily_pull</string>
        <string>--mode=props</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/daily_props_pull.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/daily_props_pull.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
