<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhlengine.morning-update</string>

    <!-- The morning update (operational/morning_update.py), 08:00 Eastern: record statistics freshness, the day's first moneyline pull, then one full cycle
         (morning capture of player prices, provisional picks, publication). The 15-minute trader keeps looking afterwards. Install with WorkingDirectory at the pinned release. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>-m</string>
        <string>operational.morning_update</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/johnburnett/nhl_engine_release</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/morning_update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/morning_update.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
