<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhlengine.moneypuck-refresh</string>

    <!-- Re-checks MoneyPuck's player/goalie/team game logs at 13:30 and 17:30 local time (the Mac runs on Eastern time). The 07:00 sync sees the logs only through
         the day before yesterday's evening; the source publishes the previous night's games later in the day. Free download, no odds credits (operational/moneypuck_refresh.py). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>-m</string>
        <string>operational.moneypuck_refresh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/johnburnett/nhl_engine_release</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/moneypuck_refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johnburnett/Downloads/nhl_engine 2/operational/logs/moneypuck_refresh.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
